<% layout("/layout/boilerplate") %>
<body>
   
    <div class="row">
        <div class="col-8 offset-2">
            <h3>Create a new listing </h3>
    <form method="POST" action="/listing" novalidate class="needs-validation" enctype="multipart/form-data">
        <div>
            <label for="title" class="form-label">Title</label>
            <input type="text" name="listing[title]"  class="form-control"  id="" placeholder="Enter title" required>
            <div class="valid-feedback">
                Looks good!
              </div>
              <div class="invalid-feedback">
                please enter valid Title
              </div>
         </div>

    <div>
        <label for="description" class="form-label">description</label>
       <textarea name="listing[description]" id="" cols="30" rows="10" class="form-control" placeholder="description"  required></textarea>
       <div class="valid-feedback">
        Looks good!
      </div>
      <div class="invalid-feedback">
        please enter valid Description
      </div>
    </div>


    <div>
      <label for="image" class="form-label">Upload Image</label>
       <input type="file" name="listing[image]" class="form-control"required>
      </div>

    <div class="row">
    <div class="col-md-4">
        <label for="price" class="form-label">Price</label>
     <input type="text" name="listing[price]" class="form-control" id="" placeholder="price" required>
     <div class="valid-feedback">
        Looks good!
      </div>
      <div class="invalid-feedback">
        please enter valid price
      </div>
    </div>

    <div class="col-md-8">
        <label for="location" class="form-label">location</label>
        <input type="location" name="listing[location]" class="form-control" id="" placeholder="location" required>
        <div class="valid-feedback">
            Looks good!
          </div>
          <div class="invalid-feedback">
            please enter valid location
          </div>
    </div>

</div>

    <div>
        <label for="country" class="form-label">country</label>
        <input type="text" name="listing[country]" id="" class="form-control" placeholder="country" required>
        <div class="valid-feedback">
            Looks good!
          </div>
    </div>
    <br><br>
       
    

       <button class="btn btn-dark">submit</button>
       <br><br>

    </form>
</div>
</div>
</body>
