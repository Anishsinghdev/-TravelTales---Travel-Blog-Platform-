<% layout("/layout/boilerplate") %>
<body>
  
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <h3><%= listingitem.title %></h3>
        <div class="card listing-card" >
            <img src="<%= listingitem.image.url %>" class="card-img-top show-img" alt="listing_images">
            <div class="card-body">
              <p class="card-text">Author: <%= listingitem.owner.username %></p> 
              <p class="card-text"><%= listingitem.description %> </p>
              <p class="card-text"> <span>&#8377;  <%= listingitem.price ? listingitem.price.toLocaleString('en-IN') : "N/A" %>/night</span> </p>
              <p class="card-text"> <%= listingitem.location %> </p>
              <p class="card-text"> <%= listingitem.country %> </p>
              </p>
            </div>
          </div>
        </div>
    </div>
    

    <% if(curruser && curruser._id.equals(listingitem.owner._id)){ %>


    <div class="d-grid gap-2">
       
<button type="button" class="btn btn-dark"> 
   <a href="/listing/<%= listingitem._id %>/edit" class="btn btn-dark"> Edit </a> </button>

<button class="border-0 bg-transparent">
<form method="post" action="/listing/<%= listingitem._id %>?_method=DELETE">
    <button class="btn btn-dark">Delete</button>
</form>
</button>
</div>

<%  } %>
<hr>
<% if(curruser){ %>
  <!-- Review form -->

      <div class="form-container ">
          <h2>Submit Your Review</h2>
          <form id="reviewForm" action="/listing/<%=listingitem._id %>/review " method="POST" novalidate class="needs-validation">
              <div class="form-group">

                <fieldset class="starability-slot mb-3">
                  <legend>Rating:</legend>
                  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                  <label for="first-rate1" title="Terrible">1 star</label>
                  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                  <label for="first-rate2" title="Not good">2 stars</label>
                  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                  <label for="first-rate3" title="Average">3 stars</label>
                  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                  <label for="first-rate4" title="Very good">4 stars</label>
                  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                  <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>

                  <label for="comment">Comment</label>
                  <textarea id="comment" name="review[comment]" placeholder="Write your review here..." required></textarea>
                  <div class="valid-feedback">
                    Looks good!
                  </div>
                  <div class="invalid-feedback">
                    please enter valid comment
                  </div>
              </div>

              

  
              <div class="form-group">
                  <button type="submit">Submit Review</button>
              </div>
          </form>
         
      </div>
      <div class="review-show">
        <hr>
        <%  } %>

       <p><b>All Reviews</b></p>
       <div class="row flex justify-content-between">
        <% for(let review of listingitem.reviews){ %>
          <div class="card col-5 mb-2 ms-3 ">
            <div class="card-body">
              <h5 class="card-title">@<%=review.author.username%></h5>
              <p class="starability-result" data-rating="<%=review.rating%>"></p>
              <p class="card-text"><%=review.comment%></p>
            </div>
        
            <% if(curruser && curruser._id.equals(review.author._id)){ %>
              <!-- Show delete button only if the current user is the author of the review -->
              <form method="POST" action="/listing/<%= listingitem._id %>/review/<%= review._id%>?_method=DELETE">
                <button class="btn btn-dark">Delete</button>
              </form>
            <% } %>
          </div>
        <% } %>
        
        <!-- <% for(let review of listingitem.reviews){ %>
          <div class="card col-5 mb-2 ms-3 ">
            <div class="card-body">
              <h5 class="card-title">@<%=review.author.username%></h5>
              <p class="starability-result" data-rating="<%=review.rating%>">
              </p>
              <p class="card-text"><%=review.comment%></p>
             
            </div>
           
            <form method="POST" action="/listing/<%= listingitem._id %>/review/<%= review._id%>?_method=DELETE">
            <button>Delete</button>
           
          </form>
          </div>
         
       <% } %> -->
      </div>
      </div>
  
    
</body>
